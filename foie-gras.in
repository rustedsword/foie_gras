#!/usr/bin/env bash
set -e

case $1 in
  -h|--help) echo "usage: foie-gras [REPO]  (default: the current directory)"; exit ;;
esac
root=$(git -C "${1:-.}" rev-parse --show-toplevel)

put() {
  mkdir -p "$(dirname "$root/$1")"
  cat > "$root/$1"
  chmod "${2:-644}" "$root/$1"
}

install_list() {
  [ -f "$root/.foie_gras" ] && return
  mkdir -p "$root/.foie_gras"
  touch "$root/.foie_gras/default"
}

install_claude() {
  local mod=.claude/skills/foie-gras
  put $mod/.claude-plugin/plugin.json <<'FOIE_GRAS_EOF'
@include claude/foie-gras/.claude-plugin/plugin.json
FOIE_GRAS_EOF
  put $mod/hooks/hooks.json <<'FOIE_GRAS_EOF'
@include claude/foie-gras/hooks/hooks.json
FOIE_GRAS_EOF
  put $mod/hooks/register.ts <<'FOIE_GRAS_EOF'
@include claude/foie-gras/hooks/register.ts
FOIE_GRAS_EOF
  put $mod/feed.py <<'FOIE_GRAS_EOF'
@include claude/foie-gras/feed.py
FOIE_GRAS_EOF
  rm -f "$root/$mod/files.sh"
  remove_feed_skill
}

# Earlier versions installed a /feed skill, plus one /feed-NAME skill per list.
remove_feed_skill() {
  local skills=$root/.claude/skills
  [ -f "$skills/feed/feed.sh" ] || return 0
  grep -l '/\.\./feed/feed\.sh' "$skills"/feed-*/SKILL.md 2>/dev/null | while read -r f; do rm -r "${f%/SKILL.md}"; done
  rm -r "$skills/feed"
}

install_codex() {
  put .codex/foie_gras.py <<'FOIE_GRAS_EOF'
@include codex/feed.py
FOIE_GRAS_EOF
  python3 "$root/.codex/foie_gras.py" --install "$root" > /dev/null
}

install_opencode() {
  put .opencode/plugins/foie_gras.ts <<'FOIE_GRAS_EOF'
@include opencode/plugins/foie_gras.ts
FOIE_GRAS_EOF
  put .opencode/foie_gras.py <<'FOIE_GRAS_EOF'
@include opencode/foie_gras.py
FOIE_GRAS_EOF
}

install_list
install_claude
install_codex
install_opencode
echo "foie_gras installed in $root"
echo "List files in .foie_gras/default. Claude Code and opencode: feed: <prompt>. Codex: approve the hook in /hooks, submit feed, then enter your prompt."
